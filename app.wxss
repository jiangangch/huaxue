page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 28rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #0b3d91;
  margin-bottom: 14rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(11, 61, 145, 0.07);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.placeholder {
  min-height: 280rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  background: #f8fafc;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn-row .btn {
  margin-right: 16rpx;
}

.btn-row .btn:last-child {
  margin-right: 0;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.btn-primary {
  background: #0b3d91;
  color: #ffffff;
}

.btn-secondary {
  background: #e5e7eb;
  color: #111827;
}