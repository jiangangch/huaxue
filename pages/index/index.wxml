<view class="container">
  <view class="hero">
    <view class="hero-kicker">化学学习地图</view>
    <view class="page-title">{{knowledgeTitle}}</view>
    <view class="hero-subtitle">按「主题 → 专题 → 课题」逐层展开，点击课题进入详情</view>
    <view class="hero-stats">
      <view class="stat-item">
        <view class="stat-num">{{themes.length}}</view>
        <view class="stat-label">主题</view>
      </view>
    </view>
  </view>

  <view wx:if="{{meta.length}}" class="meta">
    <block wx:for="{{meta}}" wx:key="*this">
      <view class="meta-chip">{{item}}</view>
    </block>
  </view>

  <block wx:for="{{themes}}" wx:key="id" wx:for-item="theme" wx:for-index="themeIndex">
    <view class="card theme-card">
      <view class="row theme-row" data-id="{{theme.id}}" bindtap="toggleTheme">
        <view class="row-main">
          <view class="theme-tag">主题 {{themeIndex + 1}}</view>
          <view class="row-title">{{theme.title}}</view>
          <view class="row-desc">{{theme.topics.length}} 个专题</view>
        </view>
        <view class="chev">{{openThemes[theme.id] ? '收起' : '展开'}}</view>
      </view>

      <view wx:if="{{openThemes[theme.id]}}" class="theme-body">
        <block wx:for="{{theme.topics}}" wx:key="id" wx:for-item="topic" wx:for-index="topicIndex">
          <view class="topic-wrap">
            <view class="row topic-row" data-id="{{topic.id}}" bindtap="toggleTopic">
              <view class="row-main">
                <view class="topic-tag">专题 {{topicIndex + 1}}</view>
                <view class="row-title">{{topic.title}}</view>
                <view class="row-desc">{{topic.lessons.length}} 个课题</view>
              </view>
              <view class="chev">{{openTopics[topic.id] ? '收起' : '展开'}}</view>
            </view>

            <view wx:if="{{openTopics[topic.id]}}">
              <block wx:for="{{topic.lessons}}" wx:key="id" wx:for-item="lesson">
                <view class="lesson" data-id="{{lesson.id}}" bindtap="openLesson">
                  <view class="lesson-dot"></view>
                  <view class="lesson-title">{{lesson.title}}</view>
                  <view class="lesson-go">查看</view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>

