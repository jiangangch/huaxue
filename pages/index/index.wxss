.hero {
  background: linear-gradient(145deg, #0b3d91 0%, #1764d6 100%);
  border-radius: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 22rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(11, 61, 145, 0.2);
}

.hero-kicker {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 10rpx;
}

.hero .page-title {
  color: #ffffff;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.95;
}

.hero-stats {
  margin-top: 14rpx;
}

.stat-item {
  display: inline-flex;
  align-items: baseline;
  background: rgba(255, 255, 255, 0.14);
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 10rpx;
}

.stat-label {
  font-size: 22rpx;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
}

.meta-chip {
  font-size: 22rpx;
  color: #1f3c73;
  background: #eaf2ff;
  border: 1rpx solid #d1e2ff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.theme-card {
  border: 1rpx solid #e6edf8;
}

.theme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.theme-tag,
.topic-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #2457a7;
  background: #edf4ff;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  margin-bottom: 8rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 650;
  color: #0f172a;
  line-height: 1.4;
}

.row-desc {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.chev {
  font-size: 22rpx;
  color: #0b3d91;
  margin-left: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
}

.theme-body {
  margin-top: 16rpx;
}

.topic-wrap {
  margin-top: 12rpx;
  padding: 14rpx 14rpx 8rpx;
  border: 1rpx solid #e8edf5;
  border-radius: 14rpx;
  background: #fbfdff;
}

.topic-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topic-row .row-title {
  font-size: 27rpx;
  color: #1f2937;
}

.lesson {
  margin-top: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf5;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
}

.lesson-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2563eb;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.lesson-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}

.lesson-go {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #0b3d91;
  background: #eff6ff;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
}

