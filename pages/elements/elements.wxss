.legend-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #334155;
  margin-right: 20rpx;
  margin-bottom: 8rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.15);
}

.legend-metal {
  background: #f59e0b;
}

.legend-nonmetal {
  background: #22c55e;
}

.legend-noble {
  background: #3b82f6;
}

.table-card {
  overflow-x: auto;
  background:
    radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.08), transparent 38%),
    radial-gradient(circle at 85% 10%, rgba(16, 185, 129, 0.08), transparent 30%),
    #ffffff;
}

.periodic-grid {
  min-width: 1080rpx;
  display: grid;
  grid-template-columns: repeat(18, 1fr);
  grid-auto-rows: 118rpx;
  grid-gap: 10rpx;
}

.grid-cell {
  border-radius: 12rpx;
  box-sizing: border-box;
}

.element-tile {
  padding: 10rpx 8rpx;
  border: 1rpx solid transparent;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 3rpx 10rpx rgba(15, 23, 42, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.element-tile:active {
  transform: scale(0.96);
  box-shadow: 0 1rpx 6rpx rgba(15, 23, 42, 0.12);
}

.empty-cell {
  border: 1rpx dashed #dbe7f4;
  background:
    linear-gradient(135deg, rgba(226, 232, 240, 0.42) 25%, transparent 25%) -8rpx 0/16rpx 16rpx,
    linear-gradient(225deg, rgba(226, 232, 240, 0.42) 25%, transparent 25%) -8rpx 0/16rpx 16rpx,
    linear-gradient(315deg, rgba(226, 232, 240, 0.42) 25%, transparent 25%) 0 0/16rpx 16rpx,
    linear-gradient(45deg, rgba(226, 232, 240, 0.42) 25%, transparent 25%) 0 0/16rpx 16rpx,
    #f8fbff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-dot {
  color: #b6c3d4;
  font-size: 30rpx;
}

.no {
  font-size: 19rpx;
  opacity: 0.78;
}

.symbol {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.name {
  font-size: 21rpx;
}

.category-metal {
  background: linear-gradient(180deg, #fffaf0 0%, #fff3db 100%);
  color: #92400e;
  border-color: #f1c774;
}

.category-nonmetal {
  background: linear-gradient(180deg, #f2fdf6 0%, #e8f9ee 100%);
  color: #166534;
  border-color: #7fd7a0;
}

.category-noble {
  background: linear-gradient(180deg, #f3f8ff 0%, #e8f1ff 100%);
  color: #1e3a8a;
  border-color: #8fb5ef;
}

.is-active {
  box-shadow: 0 0 0 4rpx rgba(11, 61, 145, 0.12), 0 8rpx 18rpx rgba(15, 23, 42, 0.1);
}

.popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  z-index: 999;
}

.popup-panel {
  width: 100%;
  max-width: 640rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.2);
}

.popup-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0b3d91;
}

.popup-subtitle {
  margin-top: 8rpx;
  margin-bottom: 18rpx;
  font-size: 25rpx;
  color: #475569;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.label {
  font-size: 26rpx;
  color: #475569;
  white-space: nowrap;
}

.value {
  font-size: 26rpx;
  color: #0f172a;
  text-align: right;
  margin-left: 18rpx;
}

.value-left {
  text-align: left;
}

.close-btn {
  margin-top: 24rpx;
  background: linear-gradient(180deg, #1d4fa6 0%, #0b3d91 100%);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
