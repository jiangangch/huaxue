<view class="container">
  <view class="page-title">{{ui.title}}</view>
  <view class="page-subtitle">{{ui.subtitle}}</view>

  <view class="card switch-card">
    <view class="switch-title">{{ui.switchTitle}}</view>
    <view class="switch-row">
      <block wx:for="{{elementButtons}}" wx:key="symbol">
        <button
          class="switch-btn {{activeSymbol === item.symbol ? 'switch-btn-active' : ''}}"
          data-symbol="{{item.symbol}}"
          bindtap="switchElement"
        >
          {{item.text}}
        </button>
      </block>
    </view>
  </view>

  <view class="card atom-card" wx:if="{{atomVisible}}">
    <view class="atom-stage">
      <block wx:for="{{layers}}" wx:key="key" wx:for-item="layer">
        <view class="orbit-layer {{layer.shellClass}}" style="width: {{layer.size}}rpx; height: {{layer.size}}rpx;">
          <view class="orbit-circle"></view>

          <view class="orbit-spin" style="animation-duration: {{layer.spinDuration}}s;">
            <block wx:for="{{layer.electrons}}" wx:key="key" wx:for-item="electron">
              <view
                class="electron-dot {{layer.electronClass}}"
                style="transform: rotate({{electron.angle}}deg) translateX({{electron.translate}}rpx);"
              ></view>
            </block>
          </view>
        </view>
      </block>

      <view class="nucleus">
        <view class="nucleus-title">{{ui.nucleus}}</view>
        <view class="nucleus-main">{{currentElement.symbol}}</view>
        <view class="nucleus-info">{{ui.protonLabel}}: {{currentElement.atomicNumber}}</view>
      </view>

      <view class="layer-side">
        <block wx:for="{{layers}}" wx:key="name" wx:for-item="layer">
          <view class="layer-side-row">
            <view class="layer-side-dot {{layer.electronClass}}"></view>
            <text class="layer-side-text">{{layer.name}}{{ui.layerSuffix}} {{layer.count}}e</text>
          </view>
        </block>
      </view>

      <view wx:if="{{flyAnimClass}}" class="fly-electron {{flyAnimClass}} {{flyElectronClass}}"></view>
    </view>

    <view class="ion-actions">
      <button class="ion-btn ion-gain" bindtap="gainElectron">{{ui.gainBtn}}</button>
      <button class="ion-btn ion-loss" bindtap="loseElectron">{{ui.lossBtn}}</button>
    </view>

    <view class="range-box">
      <text class="range-title">{{ui.commonRangeTitleWithColon}}</text>
      <text class="range-value">{{commonRangeText}}</text>
    </view>

    <view wx:if="{{operationHint}}" class="hint-box">{{operationHint}}</view>

    <view class="charge-box">
      <text class="charge-title">{{ui.chargeTitleWithColon}}</text>
      <text class="charge-value">{{chargeText}}</text>
      <text class="charge-note">{{ui.neutralRef}}</text>
    </view>
  </view>

  <view class="card layer-info-card">
    <view class="card-title">{{ui.layerInfoTitle}}</view>
    <block wx:for="{{layers}}" wx:key="name">
      <view class="layer-row">
        <text>{{item.name}}{{ui.layerSuffix}}</text>
        <text>{{item.count}}{{ui.electronLabel}}</text>
      </view>
    </block>
  </view>

  <view class="card reaction-demo-card" wx:if="{{activeReaction}}">
    <view class="card-title">{{ui.reactionDemoTitle}}</view>

    <scroll-view class="reaction-tabs" scroll-x enable-flex>
      <view class="reaction-tabs-inner">
        <block wx:for="{{reactionOptions}}" wx:key="id">
          <button
            class="reaction-tab-btn {{activeReactionId === item.id ? 'reaction-tab-btn-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectReaction"
          >
            {{item.title}}
          </button>
        </block>
      </view>
    </scroll-view>

    <view class="reaction-equation">{{activeReaction.equation}}</view>

    <view class="reaction-stage">
      <view wx:if="{{activeReaction.reactionType === 'ionic'}}" class="ionic-stage">
        <block wx:for="{{activeReaction.species}}" wx:key="id" wx:for-item="sp">
          <view class="ionic-node {{sp.slotClass}} {{demoFinal ? 'node-final' : ''}}">
            <view class="ionic-symbol">{{sp.symbol}}</view>
            <view class="ionic-name">{{sp.name}}</view>
            <view wx:if="{{demoFinal}}" class="ionic-charge">{{sp.chargeText}}</view>
          </view>
        </block>

        <block wx:for="{{activeReaction.lineClasses}}" wx:key="*this">
          <view class="ionic-line {{item}}"></view>
        </block>

        <view wx:if="{{showDemoFly}}" class="ionic-fly-dot {{demoFlyClass}} {{demoFlyColorClass}}"></view>
      </view>

      <view wx:elif="{{activeReaction.reactionType === 'covalent'}}" class="covalent-stage">
        <view class="cov-reactants">
          <view class="cov-molecule cov-h2">H-H</view>
          <view class="cov-molecule cov-o2 {{covalentPhase === 'break' ? 'bond-breaking' : ''}}">O=O</view>
          <view class="cov-molecule cov-h2">H-H</view>
        </view>

        <view class="cov-transition">
          <view class="cov-bond cov-old-bond {{(covalentPhase === 'regroup' || covalentPhase === 'form' || covalentPhase === 'final') ? 'bond-hide' : ''}}"></view>
          <view class="cov-bond cov-new-bond {{(covalentPhase === 'form' || covalentPhase === 'final') ? 'bond-show' : ''}}"></view>
          <view wx:if="{{showDemoFly}}" class="cov-fly-dot {{demoFlyClass}} {{demoFlyColorClass}}"></view>
        </view>

        <view class="cov-products {{(covalentPhase === 'form' || covalentPhase === 'final') ? 'product-show' : ''}}">H-O-H   +   H-O-H</view>
      </view>
    </view>

    <view class="reaction-transfer-box">
      <view class="transfer-head">{{demoHint}}</view>
    </view>

    <view class="reaction-actions">
      <button class="reaction-act-btn reaction-play-btn" bindtap="playReactionDemo">{{ui.playBtn}}</button>
      <button class="reaction-act-btn reaction-replay-btn" bindtap="replayReactionDemo">{{ui.replayBtn}}</button>
    </view>

    <view class="reaction-participants">
      <block wx:for="{{activeReaction.species}}" wx:key="id">
        <view class="participant-card">
          <view class="participant-head">{{item.symbol}} {{item.name}} · {{item.role}}</view>
          <view class="participant-row">
            <text class="p-label">{{ui.beforeLabel}}</text>
            <text class="p-value">{{ui.shellDistLabel}} {{item.beforeShellText}}</text>
          </view>
          <view class="participant-row">
            <text class="p-label">{{ui.afterLabel}}</text>
            <text class="p-value">{{ui.shellDistLabel}} {{item.afterShellText}}</text>
          </view>
          <view class="participant-row">
            <text class="p-label">{{ui.outerLabel}}</text>
            <text class="p-value">{{item.outerBefore}}e -> {{item.outerAfter}}e</text>
          </view>
          <view class="participant-row">
            <text class="p-label">{{ui.chargeLabel}}</text>
            <text class="p-value p-charge">{{item.chargeText}}</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{demoFinal}}" class="reaction-final-fixed">{{activeReaction.finalSummary}}</view>
  </view>
</view>